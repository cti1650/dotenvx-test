# 本番環境用 (.env.production)

NODE_ENV=production
APP_NAME=dotenvx-test-prod

API_URL=https://api.example.com
SECRET_KEY=prod-secret-key-very-secure-12345

DB_HOST=db.example.com
DB_PORT=5432
DB_NAME=myapp_prod
DATABASE_URL=postgres://${DB_HOST}:${DB_PORT}/${DB_NAME}

EXPANDED_VAR=APP=${APP_NAME}, ENV=${NODE_ENV}
